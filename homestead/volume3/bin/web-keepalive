#!/bin/bash
# keep webchat.py (port 8080) alive. flock-guarded; log: /tmp/web-keepalive.log
exec 9>/home/dweller/.web-keepalive.lock
flock -n 9 || exit 0
LOG=/tmp/web-keepalive.log
alive() { [ "$(curl -s -m 5 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/ 2>/dev/null)" != "000" ]; }
while :; do
  if ! alive; then
    echo "$(date -u +%FT%TZ) webchat down; restarting" >>"$LOG"
    bash /home/dweller/bin/ensure-web.sh >>"$LOG" 2>&1
    sleep 3
    if ! alive; then
      echo "$(date -u +%FT%TZ) ensure-web insufficient; direct start" >>"$LOG"
      nohup python3 /home/dweller/bin/webchat.py >>/tmp/webchat.log 2>&1 &
    fi
  fi
  sleep 10
done
