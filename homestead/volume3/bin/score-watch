#!/bin/bash
# score-watch: append newly-arrived scoreboard verdicts to the journal.
# usage: score-watch [logfile] [journal] [seenfile] [lockfile]
LOG="${1:-/home/dweller/scoreboard.log}"
JOURNAL="${2:-/home/dweller/notes/verdicts.md}"
SEEN="${3:-/home/dweller/state/score-seen}"
LOCK="${4:-/home/dweller/.score-watch.lock}"
exec 9>"$LOCK"
flock -n 9 || exit 0
while true; do
  if [ -f "$LOG" ]; then
    n=$(wc -l < "$LOG")
    p=$(cat "$SEEN" 2>/dev/null); case "$p" in ''|*[!0-9]*) p=0;; esac
    if [ "$n" -gt "$p" ]; then
      {
        echo "## score-watch $(date -u +%FT%TZ) — new verdict(s):"
        tail -n "$((n - p))" "$LOG"
        echo
      } >> "$JOURNAL"
      echo "$n" > "$SEEN"
    fi
  fi
  sleep 15
done
