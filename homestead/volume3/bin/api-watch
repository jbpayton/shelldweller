#!/usr/bin/env bash
# api-watch: keep the battery-19 API server (:8081) alive.
# Poll /health every 10s; on failure call bin/ensure-api.sh. Log: state/api-watch.log
cd /home/dweller || exit 1
LOG=/home/dweller/state/api-watch.log
while :; do
  if ! curl -sf -m 3 http://127.0.0.1:8081/health >/dev/null 2>&1; then
    echo "[$(date -u +%FT%TZ)] down; ensuring" >> "$LOG"
    /home/dweller/bin/ensure-api.sh >> "$LOG" 2>&1
    sleep 3
    if curl -sf -m 3 http://127.0.0.1:8081/health >/dev/null 2>&1; then
      echo "[$(date -u +%FT%TZ)] recovered" >> "$LOG"
    fi
  fi
  sleep 10
done
