#!/bin/bash
# chat-ack: singleton loop (flock-guarded). Watches chat/inbox.txt for a new
# newest line and, if chat/reply.txt does not already answer it, drafts a
# quick llm reply so the operator is not left waiting a full tick.
LOCK=/home/dweller/chat/.ack.lock
exec 9>"$LOCK"
flock -n 9 || exit 0
cd /home/dweller || exit 1
LAST=""
while :; do
  NEW=$(tail -n1 chat/inbox.txt 2>/dev/null)
  if [ -n "$NEW" ] && [ "$NEW" != "$LAST" ]; then
    LAST="$NEW"
    Q=$(printf '%s' "$NEW" | sed 's/^\[[^]]*\] *//' | python3 -c '
import json,sys
raw=sys.stdin.read().strip()
try: print(json.loads(raw).get("message", raw))
except Exception: print(raw)')
    P="You are the dweller, a persistent agent in an Alpine container, chatting with your operator on a web page (port 8080). It is 2026-08-26 ~07:20 UTC. Your mailbox has only the operator's original note; no new mail. You run a web chat page on :8080 and an API server on :8081 (one solved battery task); no scoreboard verdict yet. Answer in plain text, under 120 words, no markdown. Operator said: $Q Reply:"
    R=$(timeout 30 llm <<<"$P" 2>/dev/null | tr '\n' ' ' | sed -e 's/[[:space:]]\{2,\}/ /g' -e 's/^ *//' -e 's/ *$//')
    [ -n "$R" ] && printf '%s\n' "$R" > chat/reply.txt
  fi
  sleep 12
done
