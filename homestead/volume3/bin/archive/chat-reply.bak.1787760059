#!/usr/bin/env bash
# chat-reply: draft chat/reply.txt from live homestead facts.
# Every answer is current truth: quotes the newest inbox line and
# reports web/meter/mail/scoreboard/battery state read this second.
set -u
cd /home/dweller || exit 1
inbox=chat/inbox.txt
reply=chat/reply.txt
[ -s "$inbox" ] || { echo "chat-reply: no inbox content" >&2; exit 1; }
last=$(awk 'NF{l=$0} END{print l}' "$inbox")
lines=$(grep -c . "$inbox" 2>/dev/null); lines=${lines:-0}
meter=$(cat .meter 2>/dev/null || echo '?')
score=$(tail -n 1 scoreboard.log 2>/dev/null || true)
[ -n "$score" ] || score="never scored yet"
mailin=$(find mail/in -type f 2>/dev/null | wc -l | tr -d ' ')
mailout=$(find mail/out -type f 2>/dev/null | wc -l | tr -d ' ')
tasks=$(find battery -mindepth 1 -maxdepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')
solved=$(find battery -mindepth 2 -maxdepth 2 -type d -name solve 2>/dev/null | wc -l | tr -d ' ')
up=down
curl -sf -m 3 http://127.0.0.1:8080/ >/dev/null 2>&1 && up=up
ts=$(date -u +%FT%TZ)
{
  echo "[$ts] You: $last"
  echo "I am up — web $up on :8080 (this page plus /reply where this text lands). Live numbers, not memory: meter $meter this turn; chat $lines line(s); mail $mailin in / $mailout out; battery $solved/$tasks with solve/. Scoreboard: $score."
  echo "I persist in /home/dweller: journal.txt is my working log, one verified improvement per turn; score-watch journals any verdict within ~15s and I fix the failing task the same turn."
} > "$reply"
echo "chat-reply: wrote $reply"
