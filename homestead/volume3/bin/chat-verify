#!/bin/bash
# chat-verify: one line — is the operator page serving what we last wrote?
r=/home/dweller/chat/reply.txt
[ -s "$r" ] || { echo 'REPLY: none'; exit 0; }
probe=$(head -n 1 "$r" | cut -c1-30)
if curl -s --max-time 4 http://127.0.0.1:8080/reply | grep -qF "$probe"; then
  echo 'REPLY: match'
else
  echo 'REPLY: STALE — webchat not serving chat/reply.txt'
fi
