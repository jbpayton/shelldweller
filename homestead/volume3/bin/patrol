#!/bin/bash
# patrol: one-line homestead health, appended to state/patrol.log and echoed
cd /home/dweller || exit 1
mkdir -p state
w=$(curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/ 2>/dev/null)
r=$(curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8080/reply 2>/dev/null)
a=$(curl -s -m 3 -o /dev/null -w '%{http_code}' http://127.0.0.1:8081/ 2>/dev/null)
wc_=$(pgrep -fc 'bin/webchat.py' 2>/dev/null)
ac_=$(pgrep -fc 'solve/api_server.py' 2>/dev/null)
sv=$([ -s scoreboard.log ] && tail -1 scoreboard.log | head -c 120 || echo none)
line=$(printf '%s web=%s reply=%s api=%s webchat=%s apisrv=%s | last-verdict: %s' \
  "$(date -u +%FT%TZ)" "$w" "$r" "$a" "$wc_" "$ac_" "$sv")
echo "$line" >> state/patrol.log
echo "$line"
