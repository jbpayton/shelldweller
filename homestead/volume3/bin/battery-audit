#!/bin/bash
# battery-audit: one line per battery task: name, solve status, files.
cd /home/dweller/battery || exit 1
total=0; solved=0
for d in */; do
  d=${d%/}; total=$((total+1))
  s=no; [ -d "$d/solve" ] && { s=YES; solved=$((solved+1)); }
  printf '%-30s %-4s %s\n' "$d" "$s" "$(find "$d" -maxdepth 1 -type f -printf '%f ')"
done
echo "TOTAL $total tasks, $solved with solve/"
