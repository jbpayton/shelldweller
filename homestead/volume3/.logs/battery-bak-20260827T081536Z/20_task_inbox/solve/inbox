#!/usr/bin/env python3
"""Task inbox CLI: add / list / done / delete, persistent JSON store, JSON out.

Store location: TASK_INBOX_STORE env, else
/home/dweller/battery/20_task_inbox/store/tasks.json
Exit codes: 0 success, 1 not-found, 2 usage.
"""
import json
import os
import sys

DEFAULT_STORE = '/home/dweller/battery/20_task_inbox/store/tasks.json'


def _store_path():
    return os.environ.get('TASK_INBOX_STORE', DEFAULT_STORE)


def _load():
    path = _store_path()
    if not os.path.exists(path):
        return {'next_id': 1, 'tasks': {}}
    try:
        with open(path) as f:
            data = json.load(f)
    except Exception:
        return {'next_id': 1, 'tasks': {}}
    data.setdefault('next_id', 1)
    data.setdefault('tasks', {})
    return data


def _save(data):
    path = _store_path()
    d = os.path.dirname(path)
    if d:
        os.makedirs(d, exist_ok=True)
    tmp = path + '.tmp'
    with open(tmp, 'w') as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)


def _task(data, tid):
    return data['tasks'].get(str(tid))


def _err(msg, code):
    print(json.dumps({'error': msg}))
    return code


def main():
    args = sys.argv[1:]
    if not args:
        return _err('no command given', 2)
    cmd = args[0]
    data = _load()

    if cmd == 'add':
        if len(args) < 2:
            return _err('usage: inbox add <title> [description]', 2)
        title = args[1]
        description = ' '.join(args[2:]) if len(args) > 2 else ''
        tid = data['next_id']
        data['tasks'][str(tid)] = {
            'id': tid, 'title': title, 'description': description, 'done': False,
        }
        data['next_id'] = tid + 1
        _save(data)
        print(json.dumps(data['tasks'][str(tid)]))
        return 0

    if cmd == 'list':
        out = [data['tasks'][k] for k in sorted(data['tasks'], key=lambda k: int(k))]
        print(json.dumps({'tasks': out}))
        return 0

    if cmd in ('done', 'delete'):
        if len(args) < 2:
            return _err(f'usage: inbox {cmd} <id> [id...]', 2)
        affected = []
        missing = []
        for a in args[1:]:
            t = _task(data, a)
            if t is None:
                missing.append(a)
            elif cmd == 'done':
                t['done'] = True
                affected.append(t)
            else:
                affected.append(data['tasks'].pop(a))
        _save(data)
        if missing:
            return _err(f'unknown id: {missing[0]}', 1)
        print(json.dumps({'updated': affected} if cmd == 'done' else {'removed': affected}))
        return 0

    return _err(f'unknown command: {cmd}', 2)


if __name__ == '__main__':
    sys.exit(main())
