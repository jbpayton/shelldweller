#!/bin/sh
# llm — LLM as a Unix device, LM Studio /api/v1/chat edition. Reads a prompt
# from stdin, writes the reply to stdout. Reasoning blocks are the model's own
# business and are not printed. Metered: /home/dweller/.meter holds the
# output-token budget left this tick; refuses when it reaches zero.
prompt=$(cat)
# The model can see. LLM_IMAGE=/path/to.png (or jpg, webp, gif) sends the
# image ahead of the prompt as a second part of the same message.
imgurl=""
if [ -n "${LLM_IMAGE:-}" ]; then
  [ -r "$LLM_IMAGE" ] || { echo "llm: cannot read LLM_IMAGE=$LLM_IMAGE" >&2; exit 66; }
  case "${LLM_IMAGE##*.}" in jpg|jpeg) mt=image/jpeg;; webp) mt=image/webp;; gif) mt=image/gif;; *) mt=image/png;; esac
  imgurl="data:$mt;base64,$(base64 -w0 "$LLM_IMAGE" 2>/dev/null || base64 "$LLM_IMAGE" | tr -d '\n')"
fi
m=/home/dweller/.meter
if [ -z "${LLM_RETRIED:-}" ] && [ -f "$m" ] && [ "$(cat "$m" 2>/dev/null || echo 0)" -le 0 ] 2>/dev/null; then
  echo "llm: token budget for this tick is exhausted (see $m)" >&2; exit 75
fi
resp=$(curl -s "${LLM_ENDPOINT:-http://host.docker.internal:1234/api/v1/chat}" \
  -H "Content-Type: application/json" \
  -d "$(jq -nc --arg mo "${LLM_MODEL:-qwen/qwen3.8-27b}" --arg s "${LLM_SYSTEM:-}" --arg p "$prompt" --arg x "${LLM_MAX_OUT:-16384}" --arg r "${LLM_REASONING:-}" --arg img "$imgurl" \
        '{model:$mo, max_output_tokens:($x|tonumber)}
         + (if $img != "" then {input:[{type:"image", data_url:$img},{type:"text", content:$p}]} else {input:$p} end)
         + (if $s != "" then {system_prompt:$s} else {} end) + (if $r != "" then {reasoning:$r} else {} end)')")
msg=$(printf '%s' "$resp" | jq -r '[.output[]? | select(.type == "message") | .content] | join("\n")')
tot=$(printf '%s' "$resp" | jq -r '.stats.total_output_tokens // 0')
rsn=$(printf '%s' "$resp" | jq -r '.stats.reasoning_output_tokens // 0')
if [ -f "$m" ]; then echo $(( $(cat "$m") - tot )) > "$m"; fi
printf '%s' "$msg"
# An empty message is a fact worth stating. Trial 6: three turns lost to
# replies that were all reasoning and no message, reported as exit 0.
if [ -z "$(printf '%s' "$msg" | tr -d '[:space:]')" ]; then
  if [ -z "$resp" ]; then echo "llm: no response from ${LLM_ENDPOINT:-the model server} (curl failed or timed out)" >&2; exit 69; fi
  if [ "${rsn:-0}" -gt 0 ] 2>/dev/null; then
    # Once, and only if the caller did not choose a level: ask again with
    # reasoning off. The thinking already happened and answered nothing; the
    # retry asks for the answer. Every caller gets this — the loop's rounds
    # and the scripts it writes — so no script has to invent a fallback.
    # Regardless of the meter: this invocation already passed the check-before-
    # call, the reasoning it paid for answered nothing, and the answer is owed.
    # The next invocation is refused if the balance is gone; this one finishes.
    if [ -z "${LLM_REASONING:-}" ] && [ -z "${LLM_RETRIED:-}" ]; then
      echo "llm: the model spent $rsn tokens reasoning and wrote no message; asking once more with reasoning off." >&2
      printf '%s' "$prompt" | LLM_REASONING=off LLM_RETRIED=1 llm; exit $?
    fi
    echo "llm: the model spent $rsn tokens reasoning and wrote no message (limit ${LLM_MAX_OUT:-16384} output tokens per reply). Only the message reaches you." >&2; exit 70
  fi
  echo "llm: empty message from the model server: $(printf '%s' "$resp" | head -c 200)" >&2; exit 71
fi
