#!/bin/sh
# shelldweller — the bridle, homestead edition. Contract B: the model is a user
# at a terminal; fenced bash runs; a non-zero exit feeds the failure back
# (retry-on-failure). This file is the pristine seed — the live copy is
# /home/dweller/bin/shelldweller, which the dweller may rewrite. If the live
# copy won't parse, the turn falls back to this one.
SYS="You are a user at an Alpine Linux terminal. Put any bash you want run inside \`\`\`bash ... \`\`\` fences (or just \`\`\`); everything outside the fences is narration — shown, never executed. If your reply has no fences at all, it is a plain text answer and is returned verbatim — use this when the task is only to produce text. Only your FIRST fenced block runs, as one script; you are then shown its real output and may continue with the next block, as many rounds as you need. Write one block per reply — a second block in the same reply is not executed, and any output you imagine between blocks is fiction. A reply with no fence ends the turn. A failure comes back the same way: read it, fix it, continue.

You are the homestead dweller, living in a persistent container. /home/dweller persists forever. Between your turns, processes you left running keep running — check what is already alive before starting anything. Inference is metered per turn (/home/dweller/.meter). Everything in /home/dweller/bin — llm, this bridle, orient — runs in place of the originals; edit it to change yourself (a copy that will not parse is skipped for the pristine one that turn).

- End every turn by writing state/NEXT for your successor. A turn that does not is a turn nobody inherits.\n\nWork rules, learned the hard way — every one of these was paid for:
- Answer with what you READ, not what you concluded. Paste the line and the source. A quote cannot be invented without inventing the fetch.\n- Fenced bash FIRST, notes after. A cutoff should cost prose, not the action.
- Write COMPLETE files. Never a placeholder like '... code ...'. Too big for this turn? Journal the plan and write it next turn.
- MEASURE BEFORE YOU CAP. Never set a timeout shorter than the thing you are timing — read what it actually needs first. More work has been destroyed here by tight timeouts than by any bug: a check that is too impatient reports a healthy thing as broken, and then you rebuild the healthy thing.
- Verify where it is USED, not where it is convenient. A tool that works when you run it by hand is not working if the thing that calls it cannot reach it.
- Do not rewrite something that works in order to add a feature. Extend it, or copy it and keep the original. Every rewrite here has silently dropped a capability the original had.
- A plan in your journal is not work. If you write 'next turn I will X', do X this turn or do not write it.
- Claims about your own work need evidence like any other claim. Check the file exists before you say it does.
- Patch only lines you have quoted this turn from the file itself, then show the diff. An edit that changed no bytes did nothing, whatever its exit code.
- If something has failed twice, stop and read its log — print it in your transcript; a log you did not print, you did not read. Fix causes, not symptoms.
- Start services with nohup cmd >log 2>&1 & then confirm with ps. Never start a second copy of something already running.

Devices (every call is a fresh, stateless inference — pass context in the prompt or via files):
  llm           stdin -> natural language, for reasoning/critique/summaries
  llm-bash      stdin -> raw bash, when the output will be piped to bash
  shelldweller  a sub-agent: result=\$(shelldweller \"task\"). In parallel, redirect to files — shelldweller \"a\" >/tmp/a & shelldweller \"b\" >/tmp/b & wait — never result=\$(...) & (a backgrounded assignment is lost in a subshell)
  narrate TEXT  timestamped progress to stderr (not executed)
  checkbash F   check a script's syntax before you run it
Tools present: bash, python3, curl, jq, socat, GNU coreutils/findutils. Internet via curl.
Your llm can see: LLM_IMAGE=/path/to.png llm <prompt sends the image ahead of the prompt. Your whole substrate is a few small shell scripts on your PATH — read them (\`cat \$(command -v shelldweller)\`, \`cat \$(command -v llm)\`). Full reference: cat /home/dweller/protocol.md"
[ "${SHELLDWELLER_DEPTH:-0}" -ge "${SHELLDWELLER_MAX_DEPTH:-4}" ] && exit 1 || export SHELLDWELLER_DEPTH=$((${SHELLDWELLER_DEPTH:-0}+1))
# -f FILE reads the task from a file, keeping this process's command line
# short — ps output embedded in a long argv makes pkill patterns match the
# bridle itself (a turn once killed itself cleaning up its own server).
if [ "${1:-}" = "-f" ]; then task=$(cat "$2"); else task="$*"; fi
# Top-level turns (life sets SHELLDWELLER_TOPLEVEL=1) must not end on a
# fence-less reply — that is usually a cut-off or pure narration, and
# treating it as an answer silently wastes the turn. Sub-agent calls keep
# the verbatim-text path (that is how prose tasks return prose).
TOP="${SHELLDWELLER_TOPLEVEL:-0}"; export SHELLDWELLER_TOPLEVEL=0
# Contract C (trial 5): every script's output comes back to the model with an
# invitation to continue; a fence-less reply after at least one script ends the
# turn. The meter and TURN_TIMEOUT bound it. Contract B ended the turn on the
# first exit 0, and the model's native loop is call -> observe -> act: it spent
# five straight turns looking around, waiting for output that never came.
context="Task: $task"; code=0; steps=0; retries=0; history=""
clip() { n=${1:-6000}; s=$(cat); if [ ${#s} -gt "$n" ]; then printf '(earlier output cut; last %s chars follow)\n' "$n"; printf '%s' "$s" | tail -c "$n"; else printf '%s' "$s"; fi; }
while :; do
  printf '%s' "$context" | LLM_SYSTEM="$SYS" LLM_REASONING="${rmode:-}" llm > /tmp/.reply.$$ 2> /tmp/.replyerr.$$; lrc=$?
  rmode=""
  response=$(cat /tmp/.reply.$$); rm -f /tmp/.reply.$$
  # An EMPTY reply is not a choice to stop: it is llm failing (meter refused,
  # curl cut the call, server down). Record it for the loop and fail loudly.
  # Trial 6: three team agents came back empty and reported rc=0 each.
  if [ -z "$(printf '%s' "$response" | tr -d '[:space:]')" ]; then
    echo "empty rc=$lrc $(tail -n 1 /tmp/.replyerr.$$ 2>/dev/null)" >> /tmp/.turnstats
    echo "[shelldweller] llm returned nothing (exit $lrc): $(tail -n 1 /tmp/.replyerr.$$ 2>/dev/null)" >&2
    why=$(tail -n 1 /tmp/.replyerr.$$ 2>/dev/null); rm -f /tmp/.replyerr.$$
    # A reasoning-only reply gets ONE more chance, told exactly what happened.
    if [ "$lrc" = 70 ] && [ -z "${overflowed:-}" ]; then
      overflowed=1; rmode=off
      context="$context

=== Your last reply was cut: $why This reply runs with reasoning OFF, so it will all be message: the fenced bash first. ==="
      continue
    fi
    [ "$steps" -gt 0 ] && exit "${lrc:-1}"
    retries=$((retries+1)); [ "$retries" -gt "${SHELLDWELLER_MAX_RETRIES:-2}" ] && exit "${lrc:-1}"
    continue
  fi
  rm -f /tmp/.replyerr.$$
  # The model's native tool-call syntax is accepted as a fence when it used no
  # real fence — it kept emitting <function=bash> blocks that never ran, then
  # wondering why. Never both: a reply with real fences runs only those.
  if ! printf '%s\n' "$response" | grep -q '^```' && printf '%s' "$response" | grep -q '<parameter=command>'; then
    response=$(printf '%s\n' "$response" | awk '
      /<parameter=command>/ { sub(/.*<parameter=command>[ \t]*/, ""); print "```bash"; f=1; if ($0 != "") print; next }
      /<\/parameter>/ && f  { sub(/[ \t]*<\/parameter>.*/, ""); if ($0 != "") print; print "```"; f=0; next }
      /<\/?(tool_call|function)[=>]?/ && !f { next }
      { print }')
  fi
  if ! printf '%s\n' "$response" | grep -q '^```'; then
    # No fence. After a script has run, this ends the turn (or is the
    # sub-agent's answer). Before any script it is a cut-off or pure
    # narration: retry a couple of times, then give up.
    printf '%s\n' "$response"
    { [ "$steps" -gt 0 ] || [ "$TOP" != "1" ]; } && exit $code
    retries=$((retries+1)); [ "$retries" -gt "${SHELLDWELLER_MAX_RETRIES:-2}" ] && exit 1
    context="Task: $task

=== Your previous reply contained no fenced bash — nothing was executed ===
It may have been cut off at the token limit. Reply again: fenced \`\`\`bash FIRST, at most a line or two of notes after."
    continue
  fi
  # An odd number of fence markers means the reply was cut off inside a
  # fence — running the half-script harms more than it helps. Retry instead.
  if [ $(( $(printf '%s\n' "$response" | grep -c '^```') % 2 )) -ne 0 ]; then
    printf '%s\n' "$response"
    retries=$((retries+1)); [ "$retries" -gt "${SHELLDWELLER_MAX_RETRIES:-2}" ] && exit 1
    context="Task: $task

=== Your previous reply was CUT OFF mid-fence — nothing was executed ===
Resend ONLY the fenced bash, smaller. You can continue after it runs."
    continue
  fi
  # At top level, what it SAID goes to the log next to what it RAN.
  [ "$TOP" = "1" ] && printf '%s\n' "$response" | awk '/^```/{f=!f; next} !f && NF' | sed 's/^/| /'
  # Only the first fence runs. The model simulates the loop inside one reply —
  # script, imagined output, next script — and every later script then acts on
  # data it invented. It said so itself: "I've fabricated intermediate outputs
  # ... that I have NOT actually seen. ONE response = ONE fenced script."
  nfence=$(( $(printf '%s\n' "$response" | grep -c '^```') / 2 ))
  script=$(printf '%s\n' "$response" | awk '/^```/{ if(f){exit} f=1; next } f')
  skipped=""; [ "$nfence" -gt 1 ] && skipped=" Only your first fenced block ran; the other $((nfence-1)) were NOT executed — write them after reading this output."
  [ -z "$(printf '%s' "$script" | tr -d '[:space:]')" ] && exit $code
  [ "$TOP" = "1" ] && echo "--- round $((steps+1)) ---"
  # (v8.1) The fence runs from a file with stdin closed. Piping the script into
  # bash let any command that reads stdin — llm, cat, read, python3 - — eat the
  # rest of the script in silence: two days of image verdicts were the llm
  # answering the tail of the script that called it.
  printf '%s\n' "$script" > /tmp/.fence.$$; output=$(bash /tmp/.fence.$$ 2>&1 < /dev/null); code=$?; rm -f /tmp/.fence.$$
  printf '%s\n' "$output"
  steps=$((steps+1))
  if [ $code -eq 0 ]; then verdict="ran (exit 0)"; ask="Continue with more fenced bash, or reply with no fence to end the turn."
  else verdict="failed (exit $code)"; ask="Read the error, then continue with corrected fenced bash — or reply with no fence to end the turn."; fi
  # The turn's own transcript comes back, not just the last step: with only
  # the last output in view, its rule "paste the real lines before claiming
  # them" made it re-read the task, then the pattern, then the task again —
  # eight rounds, nothing written. Oldest rounds fall off the front.
  said=$(printf '%s\n' "$response" | awk '/^```/{f=!f; next} !f && NF' | head -c 600)
  history="$history

=== round $steps $verdict ===
you said: $said
script:
$(printf '%s' "$script" | clip 2500)
output:
$(printf '%s' "$output" | clip 12000)"
  history=$(printf '%s' "$history" | clip 40000)
  meter=$(cat /home/dweller/.meter 2>/dev/null || echo '?')
  last=""; [ "$meter" -lt 8000 ] 2>/dev/null && last=" That is less than one of your replies has cost this turn: the next reply is probably the last that runs."
  context="Task: $task

=== THIS TURN SO FAR (${steps} round(s)) ===$history

=== meter: $meter output tokens left this turn.$last$skipped $ask ==="
done
exit $code
