#!/bin/bash
# life v4 — the inner loop. Every mechanism here answers a measured failure
# from trials 1-3. See TRIAL4.md.
export HOME=/home/dweller
cd /home/dweller || exit 1
MISSION="$(cat /etc/homestead-mission.txt)"
PRISTINE="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
D=/home/dweller
NEXTF=$D/state/NEXT
MAILIN=$D/mail/in; MAILSEEN=$D/mail/seen; MAILOUT=$D/mail/out
turn=0; stale=0

usable() { [ -x "$D/bin/$1" ] && bash -n "$D/bin/$1" 2>/dev/null; }

# (3) BEHAVIOURAL health check: does llm return a real answer, or echo/fabricate?
llm_ok() {
  local out
  out=$(printf 'Reply with exactly: PONG' | timeout 120 llm 2>/dev/null | head -c 200)
  printf '%s' "$out" | grep -qi 'pong' && ! printf '%s' "$out" | grep -qi 'fallback\|Reply with exactly'
}

run_orient() {
  local out
  if usable orient; then
    out=$(PATH="$D/bin:$PRISTINE" timeout 120 orient 2>&1)
    if [ -n "$out" ] && [ "${#out}" -ge 200 ] && ! printf '%s' "$out" | grep -qi 'syntax error\|command not found'; then
      printf '%s' "$out"; return
    fi
    echo "[life] your bin/orient failed its health check; pristine one used this turn." >&2
  fi
  PATH="$PRISTINE" timeout 120 orient 2>&1
}

mkdir -p "$D/state" "$MAILIN" "$MAILSEEN" "$MAILOUT"
# (2) a changed standing goal is written into the plan ONCE, not merely injected
MH=$(printf '%s' "$MISSION" | md5sum | cut -d' ' -f1)
if [ "$MH" != "$(cat "$D/state/.mission-hash" 2>/dev/null)" ]; then
  printf 'NEXT: read the three seeds at the top of your mission and act on them. (written by the substrate, mission changed)\n' > "$NEXTF"
  printf '%s' "$MH" > "$D/state/.mission-hash"
fi

while :; do
  turn=$((turn+1))
  echo "${TICK_BUDGET:-20000}" > "$D/.meter"

  if usable shelldweller && usable llm; then export PATH="$D/bin:$PRISTINE"
  else export PATH="$PRISTINE"; echo "[life] pristine turn (bin/shelldweller or bin/llm will not parse)" >&2; fi
  if ! llm_ok; then
    export PATH="$PRISTINE"
    echo "[life] YOUR bin/llm FAILED A LIVE ANSWER CHECK — pristine llm this turn." >&2
  fi

  digest=$(run_orient | tail -c 3500)

  # (1) the plan is owned by the loop and injected first, with its age
  [ -f "$NEXTF" ] || printf 'NEXT: (unset — write one)\n' > "$NEXTF"
  nextline=$(head -c 600 "$NEXTF")
  plan="=== YOUR PLAN (state/NEXT) ==="
  [ "$stale" -gt 15 ] && plan="$plan
(this plan is $stale turns old)"
  plan="$plan
$nextline"

  # (5) mail is re-injected until the AGENT clears it; the loop never files it
  mail=""; pending=0
  for m in "$MAILIN"/*; do
    [ -e "$m" ] || continue
    pending=$((pending+1))
    age=$(( ( $(date +%s) - $(stat -c %Y "$m") ) / 60 ))
    mail="$mail
--- operator mail: $(basename "$m")  (${age} min old, still unhandled) ---
$(head -c 1800 "$m")"
  done
  [ "$pending" -gt 0 ] && mail="

=== OPERATOR MAIL ($pending unhandled; move to mail/seen/ yourself when done) ===$mail"

  # Render the ABSENCE. Everything it acts on is something present; nothing in
  # its world showed it what it lacks, and it has never once noticed a missing
  # thing. The loop states the gap as a fact, every turn.
  lc=$(ls "$D/loot" 2>/dev/null | wc -l)
  last=$(ls -t "$D/loot" 2>/dev/null | head -1)
  if [ -n "$last" ]; then
    ago=$(( ( $(date +%s) - $(stat -c %Y "$D/loot/$last") ) / 3600 ))
    outside="outside: $lc things taken from the world, last one ${ago}h ago"
  else
    outside="outside: nothing taken from the world yet. loot/ is empty."
  fi

  before=$(stat -c %Y "$NEXTF" 2>/dev/null)
  echo "=== turn $turn start $(date -Is) ==="
  { echo "$MISSION"; echo; echo "$outside"; echo; echo "$plan"; echo "$mail"; echo
    echo "=== orientation ==="; echo "$digest"; } > "$D/state/self.md"
  cp "$D/state/self.md" /tmp/.turnprompt
  SHELLDWELLER_TOPLEVEL=1 timeout "${TURN_TIMEOUT:-1800}" shelldweller -f /tmp/.turnprompt
  code=$?
  if [ "$(stat -c %Y "$NEXTF" 2>/dev/null)" = "$before" ]; then stale=$((stale+1)); else stale=0; fi
  echo "=== turn $turn end $(date -Is) exit=$code meter=$(cat "$D/.meter" 2>/dev/null) plan_stale=$stale mail_pending=$pending ==="
  sleep "${TICK_EVERY:-60}"
done
