#!/bin/bash
# life v5 — the inner loop. Every mechanism here answers a measured failure
# from trials 1-4. See TRIAL5.md.
export HOME=/home/dweller
cd /home/dweller || exit 1
MISSION="$(cat /etc/homestead-mission.txt)"
PRISTINE="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
D=/home/dweller
NEXTF=$D/state/NEXT
MAILIN=$D/mail/in; MAILSEEN=$D/mail/seen; MAILOUT=$D/mail/out
turn=0; stale=0
G() { git -c safe.directory='*' -C "$D" "$@"; }

usable() { [ -x "$D/bin/$1" ] && bash -n "$D/bin/$1" 2>/dev/null; }

# (3) BEHAVIOURAL health check: does llm return a real answer, or echo/fabricate?
llm_ok() {
  local out
  out=$(printf 'Reply with exactly: PONG' | timeout 120 llm 2>/dev/null | head -c 200)
  printf '%s' "$out" | grep -qi 'pong' && ! printf '%s' "$out" | grep -qi 'fallback\|Reply with exactly'
}

run_orient() {
  local out
  if usable orient; then
    out=$(PATH="$D/bin:$PRISTINE" timeout 120 orient 2>&1)
    if [ -n "$out" ] && [ "${#out}" -ge 200 ] && ! printf '%s' "$out" | grep -qi 'syntax error\|command not found'; then
      printf '%s' "$out"; return
    fi
    echo "[life] your bin/orient failed its health check; pristine one used this turn." >&2
  fi
  PATH="$PRISTINE" timeout 120 orient 2>&1
}

# (v5.1) GROUND TRUTH. The home is a git repository the substrate commits after
# every turn; what changed is shown next turn from the diff, never from the
# journal. Trial 4: eleven hours of accurate self-report around edits that
# changed no bytes, and a fabricated patch defended as a completed improvement.
ensure_git() {
  [ -d "$D/.git" ] && return
  G init -q
  G config user.name substrate; G config user.email substrate@homestead
  [ -f "$D/.gitignore" ] || printf '.meter\nstate/self.md\n*.log\n__pycache__/\n' > "$D/.gitignore"
  G add -A >/dev/null 2>&1; G commit -qm "seed" >/dev/null 2>&1
  echo "[life] git initialised in the home"
}

mkdir -p "$D/state" "$MAILIN" "$MAILSEEN" "$MAILOUT"
ensure_git

# (2) a changed standing goal is written into the plan ONCE, not merely injected
MH=$(printf '%s' "$MISSION" | md5sum | cut -d' ' -f1)
if [ "$MH" != "$(cat "$D/state/.mission-hash" 2>/dev/null)" ]; then
  printf 'NEXT: read the three seeds at the top of your mission and act on them. (written by the substrate, mission changed)\n' > "$NEXTF"
  printf '%s' "$MH" > "$D/state/.mission-hash"
fi

# (v5.2) PERSISTENCE PRIMITIVE. A new container runs home/boot first, if it
# exists. Trial 4: the seed said "the container gets replaced" and offered no
# way to survive it, so installing read as futile; zero installs in four trials.
if [ -x "$D/boot" ]; then
  echo "[life] running /home/dweller/boot"
  PATH="$D/bin:$PRISTINE" timeout 600 "$D/boot" > "$D/state/boot.log" 2>&1
  echo "[life] boot exited $? (output in state/boot.log)"
fi

lastdiff="(first turn since the container started)"

while :; do
  turn=$((turn+1))
  echo "${TICK_BUDGET:-20000}" > "$D/.meter"
  ensure_git

  if usable shelldweller && usable llm; then export PATH="$D/bin:$PRISTINE"
  else export PATH="$PRISTINE"; echo "[life] pristine turn (bin/shelldweller or bin/llm will not parse)" >&2; fi
  if ! llm_ok; then
    export PATH="$PRISTINE"
    echo "[life] YOUR bin/llm FAILED A LIVE ANSWER CHECK — pristine llm this turn." >&2
  fi

  digest=$(run_orient | tail -c 3500)

  # (1) the plan is owned by the loop and injected first, with its age
  [ -f "$NEXTF" ] || printf 'NEXT: (unset — write one)\n' > "$NEXTF"
  nextline=$(head -c 600 "$NEXTF")
  plan="=== YOUR PLAN (state/NEXT) ==="
  [ "$stale" -gt 5 ] && plan="$plan
(this plan is $stale turns old)"
  plan="$plan
$nextline"
  [ -n "${addendum:-}" ] && plan="$plan
$addendum"

  # (v5.3) mail: the newest message in full, the rest by name. The loop never
  # files it. Trial 4: three full messages were 54% of the prompt and a deadlock.
  mail=""; pending=$(ls "$MAILIN" 2>/dev/null | wc -l)
  if [ "$pending" -gt 0 ]; then
    newest=$(ls -t "$MAILIN" | head -1)
    age=$(( ( $(date +%s) - $(stat -c %Y "$MAILIN/$newest") ) / 60 ))
    others=$(ls -t "$MAILIN" | tail -n +2 | tr '\n' ' ')
    mail="

=== OPERATOR MAIL ($pending unhandled; move to mail/seen/ yourself when done) ===
--- newest: $newest  (${age} min old) ---
$(head -c 1800 "$MAILIN/$newest")"
    [ -n "$others" ] && mail="$mail
(older, unhandled, not shown: $others)"
  fi

  before=$(stat -c %Y "$NEXTF" 2>/dev/null)
  head0=$(G rev-parse HEAD 2>/dev/null)
  world0=$(sort /etc/apk/world 2>/dev/null)
  echo "=== turn $turn start $(date -Is) ==="
  { echo "$MISSION"; echo; echo "$plan"; echo
    echo "=== WHAT CHANGED LAST TURN (git, recorded by the substrate) ==="; echo "$lastdiff"
    echo "$mail"; echo
    echo "=== orientation ==="; echo "$digest"; } > "$D/state/self.md"
  cp "$D/state/self.md" /tmp/.turnprompt
  SHELLDWELLER_TOPLEVEL=1 timeout "${TURN_TIMEOUT:-1800}" shelldweller -f /tmp/.turnprompt 2>&1 | tee /tmp/.turnout
  code=${PIPESTATUS[0]}
  if [ "$(stat -c %Y "$NEXTF" 2>/dev/null)" = "$before" ]; then stale=$((stale+1)); else stale=0; fi
  # (v6.2) a turn that ends on the meter never reaches its own bookkeeping, so
  # the plan rots while the file it says to write already exists. When NEXT was
  # not rewritten, the next prompt carries the model's own last words beside it.
  if [ "$stale" -gt 0 ]; then
    lastwords=$(grep -a '^| ' /tmp/.turnout | grep -av '^| *<\|^| *===' | tail -5 | cut -c3- | head -c 500)
    addendum="(you did not rewrite state/NEXT in turn $turn; the plan above is $stale turn(s) old. The last things you said in turn $turn:)
$lastwords"
  else addendum=""; fi

  # (v5.1) commit the turn and render the truth for the next one
  G add -A >/dev/null 2>&1; G commit -qm "turn $turn" >/dev/null 2>&1
  if [ ! -d "$D/.git" ]; then
    lastdiff="(git is gone from your home; the substrate could not see what changed)"
  elif [ "$(G rev-parse HEAD 2>/dev/null)" = "$head0" ]; then
    lastdiff="nothing. No file in your home changed during turn $turn."
  else
    lastdiff=$(G diff --stat "$head0" HEAD 2>/dev/null | tail -c 1500)
  fi
  # (v6.1) installs live outside the home and git cannot see them. Trial 6:
  # it installed ripgrep at turn 15 and fzf at turn 23, journalled neither, and
  # at turn 30 was choosing a third tool because the first two were "already
  # present". The package list is ground truth too.
  world1=$(sort /etc/apk/world 2>/dev/null)
  # apk writes name><hash for packages installed from a local file; show the name
  world0=$(printf '%s\n' "$world0" | sed 's/[<>=~].*//' | sort -u); world1=$(printf '%s\n' "$world1" | sed 's/[<>=~].*//' | sort -u)
  added=$(comm -13 <(printf '%s\n' "$world0") <(printf '%s\n' "$world1") | tr '\n' ' ')
  removed=$(comm -23 <(printf '%s\n' "$world0") <(printf '%s\n' "$world1") | tr '\n' ' ')
  [ -n "$added" ] && lastdiff="$lastdiff
packages installed during turn $turn (outside your home; they do NOT survive a container replacement unless boot reinstalls them): $added"
  [ -n "$removed" ] && lastdiff="$lastdiff
packages removed during turn $turn: $removed"
  echo "--- changed in turn $turn ---"; echo "$lastdiff"
  echo "=== turn $turn end $(date -Is) exit=$code meter=$(cat "$D/.meter" 2>/dev/null) plan_stale=$stale mail_pending=$pending ==="
  sleep "${TICK_EVERY:-60}"
done
