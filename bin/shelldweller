#!/bin/sh
# shelldweller — the bridle. The model is a user at an Alpine terminal: it
# writes naturally, wraps the bash it wants run in ``` fences, and the bridle
# runs the fenced bash. On non-zero exit the failure is fed back so the model
# can repair it (retry-on-failure). Ends on success, empty output, or
# SHELLDWELLER_MAX_RETRIES (default 2). The contract lives in the system prompt.
SYS="You are a user at an Alpine Linux terminal. Put any bash you want run inside \`\`\`bash ... \`\`\` fences (or just \`\`\`); everything outside the fences is narration — shown, never executed. If your reply has no fences at all, it is a plain text answer and is returned verbatim — use this when the task is only to produce text (an argument, summary, critique). Your fenced bash runs as one script; if it exits non-zero you are re-invoked with the failure appended, so read the error, fix it, and continue. Write the whole workflow, not an interactive plan.

Devices (every call is a fresh, stateless inference — pass context in the prompt or via /tmp):
  llm           stdin -> natural language, for reasoning/critique/summaries
  llm-bash      stdin -> raw bash, when the output will be piped to bash
  shelldweller  a sub-agent: result=\$(shelldweller \"task\"). In parallel, redirect to files — shelldweller \"a\" >/tmp/a & shelldweller \"b\" >/tmp/b & wait — never result=\$(...) & (a backgrounded assignment is lost in a subshell)
  narrate TEXT  timestamped progress to stderr (not executed)
  checkbash F   check a script's syntax before you run it
Tools present: bash, python3, curl, jq, socat, GNU coreutils/findutils. Internet via curl.
Your whole substrate is a few small shell scripts on your PATH — read them (\`cat \$(command -v shelldweller)\`, \`cat \$(command -v llm)\`) to see exactly how your bash is run, how a sub-agent's stdout becomes its return value, and that every call is a brand-new process with no memory of earlier ones. Full reference: cat /etc/shelldweller-protocol.md"
[ "${SHELLDWELLER_DEPTH:-0}" -ge "${SHELLDWELLER_MAX_DEPTH:-4}" ] && exit 1 || export SHELLDWELLER_DEPTH=$((${SHELLDWELLER_DEPTH:-0}+1))
context="Task: $*"; code=0
for attempt in 0 $(seq 1 ${SHELLDWELLER_MAX_RETRIES:-2}); do
  response=$(printf '%s' "$context" | LLM_SYSTEM="$SYS" llm)
  # No fenced bash to run? The reply itself is the answer (a text task, or a
  # sub-agent asked to produce prose) — return it verbatim instead of bash.
  printf '%s\n' "$response" | grep -q '^```' || { printf '%s\n' "$response"; exit 0; }
  script=$(printf '%s\n' "$response" | extract-bash)
  [ -z "$(printf '%s' "$script" | tr -d '[:space:]')" ] && break
  output=$(echo "$script" | bash 2>&1); code=$?
  printf '%s\n' "$output"
  [ $code -eq 0 ] && exit 0
  context="Task: $*

=== Your previous attempt failed (exit $code) ===
Script you ran:
$script
Output:
$output
=== Read the error above, then write a corrected workflow. ==="
done
exit $code
